# «Клиентский радар» — все ключи и секреты сервера.
# Заполните значения после знака «=». Этот файл НЕ коммитится в git
# (в репозитории лежит только шаблон .env.example без значений).
# Ключи пользователей (их личные Checko и ИИ) сюда не пишутся:
# по ТЗ (п. 9.4) их вводят в Mini App, а сервер хранит их в БД в зашифрованном виде.

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @
TELEGRAM_BOT_USERNAME=
# Публичный HTTPS-адрес Mini App
WEBAPP_URL=
# Секрет для проверки вебхука Telegram (любая длинная случайная строка)
TELEGRAM_WEBHOOK_SECRET=

# --- Шифрование и сессии ---
# Мастер-ключ для шифрования пользовательских ключей в БД (AES-256-GCM), 32 байта в base64.
# Сгенерировать: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_MASTER_KEY=
# Секрет подписи сессий Mini App (любая длинная случайная строка)
SESSION_SECRET=

# --- База данных и очереди ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar
DATABASE_URL=postgresql+asyncpg://radar:ПАРОЛЬ@db:5432/radar
REDIS_URL=redis://redis:6379/0

# --- Checko (только для разработки и этапа 0: проверка API) ---
# Ваш личный/тестовый ключ с checko.ru. В продакшене каждый пользователь вводит свой ключ в Mini App.
CHECKO_DEV_API_KEY=

# --- ИИ-провайдеры (только для разработки и тестов адаптеров) ---
# В продакшене пользователи подключают свои ключи в разделе «Мой ИИ».
GIGACHAT_DEV_AUTH_KEY=
# Путь к корневому сертификату Минцифры (PEM) для GigaChat. run_mac.sh скачивает его сам
GIGACHAT_CA_FILE=
YANDEX_GPT_DEV_API_KEY=
YANDEX_GPT_DEV_FOLDER_ID=
OPENAI_DEV_API_KEY=
ANTHROPIC_DEV_API_KEY=

# --- Администрирование ---
# Telegram ID суперадмина (узнать можно у @userinfobot)
SUPERADMIN_TELEGRAM_ID=

# --- Timeweb Cloud (управление серверами через API) ---
# Нужен только для развёртывания (создать VPS, БД, домен). На сам сервер в .env приложения НЕ копировать.
TIMEWEB_CLOUD_TOKEN=
